log_format safe_access escape=json
    '{"timestamp":"$time_iso8601","remote_addr":"$remote_addr",'
    '"request_id":"$request_id","method":"$request_method",'
    '"path":"$uri","status":$status,"bytes":$body_bytes_sent,'
    '"request_time":$request_time}';
access_log /dev/stdout safe_access;

server {
    listen 80;
    server_name ${DOMAIN};

    client_max_body_size 100m;

    location / {
        proxy_pass http://api:${APP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }
}
