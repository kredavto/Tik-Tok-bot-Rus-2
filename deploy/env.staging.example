APP_ENV=staging
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8080
API_WORKERS=2
PUBLIC_BASE_URL=https://staging.example.com
TIMEZONE=Europe/Moscow

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
TELEGRAM_DELIVERY_MODE=webhook
TELEGRAM_WEBHOOK_PATH=/api/v1/webhooks/telegram
TELEGRAM_ADMIN_IDS=

DATABASE_URL=postgresql+asyncpg://tiktok:tiktok@postgres:5432/tiktok_loader
POSTGRES_DB=tiktok_loader
POSTGRES_USER=tiktok
POSTGRES_PASSWORD=replace_me

REDIS_URL=redis://redis:6379/0
STORAGE_DIR=./data/videos

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://staging.example.com/api/v1/oauth/tiktok/callback
TIKTOK_PUBLISH_ENABLED=false

ROBOKASSA_MERCHANT_LOGIN=replace_me
ROBOKASSA_PASSWORD_1=replace_me
ROBOKASSA_PASSWORD_2=replace_me
ROBOKASSA_RESULT_URL=https://staging.example.com/api/v1/payments/robokassa/result
ROBOKASSA_SUCCESS_URL=https://staging.example.com/api/v1/payments/robokassa/success
ROBOKASSA_FAIL_URL=https://staging.example.com/api/v1/payments/robokassa/fail
ROBOKASSA_TEST_MODE=true

TOKEN_ENCRYPTION_KEY=generate_with_python_fernet
ADMIN_API_TOKEN=replace_me
ADMIN_CSRF_TOKEN=replace_me
