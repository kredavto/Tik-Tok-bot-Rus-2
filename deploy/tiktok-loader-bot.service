[Unit]
Description=Tik-Tok Loader Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/Tik-Tok-bot-Rus-2
EnvironmentFile=/opt/Tik-Tok-bot-Rus-2/.env
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

