APP_ENV=development
APP_VERSION=0.2.0-rc.1
APP_HOST=0.0.0.0
APP_PORT=8080
API_WORKERS=1
PUBLIC_BASE_URL=http://localhost:8080
TIMEZONE=Europe/Moscow
DOMAIN=localhost
NGINX_TEMPLATE=http.conf.template
TLS_CERT_DIR=./deploy/nginx/certs
APP_IMAGE=tik-tok-loader

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DELIVERY_MODE=polling
TELEGRAM_WEBHOOK_PATH=/api/v1/webhooks/telegram
TELEGRAM_WEBHOOK_CHECK_SECONDS=300
TELEGRAM_ADMIN_IDS=

DATABASE_URL=postgresql+asyncpg://tiktok:tiktok@postgres:5432/tiktok_loader
POSTGRES_DB=tiktok_loader
POSTGRES_USER=tiktok
POSTGRES_PASSWORD=replace_me

REDIS_URL=redis://redis:6379/0
STORAGE_DIR=./data/videos

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/api/v1/oauth/tiktok/callback
TIKTOK_WEBHOOK_SECRET=
TIKTOK_PUBLISH_ENABLED=false

ROBOKASSA_MERCHANT_LOGIN=replace_me
ROBOKASSA_PASSWORD_1=replace_me
ROBOKASSA_PASSWORD_2=replace_me
ROBOKASSA_RESULT_URL=http://localhost:8080/api/v1/payments/robokassa/result
ROBOKASSA_SUCCESS_URL=http://localhost:8080/api/v1/payments/robokassa/success
ROBOKASSA_FAIL_URL=http://localhost:8080/api/v1/payments/robokassa/fail
ROBOKASSA_TEST_MODE=true

TOKEN_ENCRYPTION_KEY=generate_with_python_fernet
ADMIN_API_TOKEN=replace_me
ADMIN_CSRF_TOKEN=replace_me

RATE_LIMIT_PER_MINUTE=120
BACKUP_DIR=./backups
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SEC=300
DRAMATIQ_PROCESSES=1
DRAMATIQ_THREADS=4
SCHEDULER_TICK_SECONDS=10
SUBSCRIPTION_SWEEP_SECONDS=60
TOKEN_REFRESH_SWEEP_SECONDS=900
RETENTION_SWEEP_SECONDS=3600
TOKEN_REFRESH_LEAD_SECONDS=3600
MAINTENANCE_BATCH_SIZE=100
VIDEO_RETENTION_HOURS=24
LOG_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=14
AUDIT_LOG_RETENTION_DAYS=365
