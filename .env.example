APP_ENV=development
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8080
API_WORKERS=1
PUBLIC_BASE_URL=https://example.com
TIMEZONE=UTC

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=

DATABASE_URL=postgresql+asyncpg://tiktok:tiktok@postgres:5432/tiktok_loader
POSTGRES_DB=tiktok_loader
POSTGRES_USER=tiktok
POSTGRES_PASSWORD=replace_me

REDIS_URL=redis://redis:6379/0
STORAGE_DIR=./data/videos

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://example.com/oauth/tiktok/callback
TIKTOK_WEBHOOK_SECRET=
TIKTOK_PUBLISH_ENABLED=false

ROBOKASSA_MERCHANT_LOGIN=replace_me
ROBOKASSA_PASSWORD_1=replace_me
ROBOKASSA_PASSWORD_2=replace_me
ROBOKASSA_RESULT_URL=https://example.com/payments/robokassa/result
ROBOKASSA_SUCCESS_URL=https://example.com/payments/robokassa/success
ROBOKASSA_FAIL_URL=https://example.com/payments/robokassa/fail
ROBOKASSA_TEST_MODE=true

TOKEN_ENCRYPTION_KEY=generate_with_python_fernet
ADMIN_API_TOKEN=replace_me
ADMIN_CSRF_TOKEN=replace_me

RATE_LIMIT_PER_MINUTE=120
BACKUP_DIR=./backups
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SEC=300
DRAMATIQ_PROCESSES=1
DRAMATIQ_THREADS=4
VIDEO_RETENTION_HOURS=24
LOG_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=14
AUDIT_LOG_RETENTION_DAYS=365
